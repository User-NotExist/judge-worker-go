# devapi + devtool (development only). Build context = repo root.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/devapi ./cmd/devapi && CGO_ENABLED=0 go build -o /out/devtool ./cmd/devtool
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/ /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/devapi"]
